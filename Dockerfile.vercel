FROM node:24-bookworm-slim AS build
ENV NEXT_TELEMETRY_DISABLED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip curl libglib2.0-0 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY requirements.txt ./
COPY scripts/setup-model.mjs ./scripts/setup-model.mjs
RUN python3 -m pip install --upgrade --target .python -r requirements.txt && npm run setup:model
COPY . .
RUN mkdir -p public && npm run build

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PYTHONDONTWRITEBYTECODE=1 PYTHON_BIN=python3 HOSTNAME=0.0.0.0 PORT=3000 POLICYDIFF_DATA_DIR=/tmp/policydiff/postgres
RUN apt-get update && apt-get install -y --no-install-recommends python3 libglib2.0-0 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /app/.next/standalone ./
# Next's file tracer cannot resolve ONNX's platform-dependent require paths.
# Keep the complete native runtime and its matching JS API in the image.
COPY --from=build --chown=node:node /app/node_modules/onnxruntime-node ./node_modules/onnxruntime-node
COPY --from=build --chown=node:node /app/node_modules/onnxruntime-common ./node_modules/onnxruntime-common
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/demo ./demo
COPY --from=build --chown=node:node /app/db ./db
COPY --from=build --chown=node:node /app/certs ./certs
COPY --from=build --chown=node:node /app/worker ./worker
COPY --from=build --chown=node:node /app/.python ./.python
COPY --from=build --chown=node:node /app/.data/models ./.data/models
USER node
RUN node --input-type=module -e "await import('@huggingface/transformers'); await import('@electric-sql/pglite'); console.log('Server runtime dependencies loaded')"
EXPOSE 3000
CMD ["node", "server.js"]

