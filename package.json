{
  "name": "policydiff-ai",
  "version": "1.0.0",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "e2e": "playwright test",
    "setup:python": "python -m pip install --upgrade --target .python -r requirements.txt",
    "setup:model": "node scripts/setup-model.mjs",
    "setup": "npm run setup:python && npm run setup:model"
  },
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@huggingface/transformers": "^4.3.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.163",
    "diff": "^9.0.0",
    "geist": "^1.9.2",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
