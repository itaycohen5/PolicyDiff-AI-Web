# Optional. Copy to .env.local and restart to enable ClauseLens through OpenRouter.
OPENROUTER_API_KEY=

# Omit DATABASE_URL to use embedded PostgreSQL with pgvector.
# DATABASE_URL=postgresql://policydiff:policydiff@127.0.0.1:5442/policydiff
# PYTHON_BIN=python
# POLICYDIFF_DATA_DIR=.data
# POLICYDIFF_DEMO_ONLY=1

# Hosted Vercel mode. Leave these unset for the local persistent workspace.
# POLICYDIFF_STATIC_DEMO=1
# POLICYDIFF_CLOUD_MODE=1
# POLICYDIFF_PUBLIC_ACCESS=1
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt
# POLICYDIFF_SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# Optional private deployment: omit PUBLIC_ACCESS and set an access code.
# POLICYDIFF_ACCESS_CODE=GENERATE_A_PRIVATE_ACCESS_CODE_AT_LEAST_16_CHARACTERS
